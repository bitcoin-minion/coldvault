# ---------------------------------------------------------------------------
# Coldvault configuration — copy to `coldvault.env` and fill in.
#
#     cp coldvault.env.example coldvault.env
#     chmod 600 coldvault.env
#
# This file holds the only two secrets the application has. Keep it OUTSIDE the
# document root — the default location is right here, one level above public/,
# which is where env.php looks unless you set the COLDVAULT_ENV environment
# variable to a different path.
#
# It is listed in .gitignore. Never commit it.
#
# Format: NAME=value, one per line. Split on the FIRST '=', so a value may
# itself contain '='. Lines starting with '#' are ignored. Matching surrounding
# quotes are stripped, so a password with spaces can be written "like this".
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# APP_KEY  (required)
#
# 32 random bytes, base64-encoded. Generate one with:
#
#     php tools/genkey.php
#
# It encrypts the stored authenticator secrets and hashes the backup codes and
# invite codes. It does NOT encrypt recovery phrases — those are encrypted under
# each vault's own keyword, which is never stored anywhere.
#
# READ THIS TWICE:
#   Lose this key and every account is locked out permanently. The vault
#   ciphertext survives, but no authenticator code and no backup code can be
#   verified, so nothing can sign in to reach it. Changing the key on a live
#   instance has exactly the same effect.
#   Back it up off the server before you create your first account.
#
# The app refuses to start unless this decodes to exactly 32 bytes.
# ---------------------------------------------------------------------------
APP_KEY=


# ---------------------------------------------------------------------------
# Database  (required)
#
# Give Coldvault its OWN database and its OWN user. Grant that user rights on
# nothing else — then a leak of these credentials cannot reach anything but the
# ciphertext, which is useless without the keywords.
#
# DB_PORT is optional; leave it empty for the default, which also lets a
# DB_HOST of `localhost` connect over the local socket.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=
DB_NAME=coldvault
DB_USER=coldvault
DB_PASS=


# ---------------------------------------------------------------------------
# OTP_ISSUER  (optional, default: Coldvault)
#
# The label an authenticator app shows for accounts on this instance. Users see
# it next to their 6-digit code, so pick something they will recognise. If you
# run more than one instance, make them different or the entries look identical
# in the app.
# ---------------------------------------------------------------------------
OTP_ISSUER=Coldvault


# ---------------------------------------------------------------------------
# LOCAL_MODE  (optional, default: off)
#
# Set to 1 to allow plain http:// so you can open the app on localhost while
# developing. It also drops the Secure flag from the session cookie.
#
# NEVER set this on a host anyone else can reach. The keyword IS the encryption
# key: over cleartext HTTP, anyone on the network path reads it, and with it the
# recovery phrase. Leave it empty in production.
# ---------------------------------------------------------------------------
LOCAL_MODE=
